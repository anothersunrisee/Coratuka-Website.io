{
  "version": "1.0.0",
  "lastUpdated": "2025-11-08",
  "projectName": "CORATUKA Manager Dashboard",
  "projectDescription": "Comprehensive conservation management platform for marine education and community engagement",

  "branding": {
    "colors": {
      "primary": "#15C5CE",
      "primaryLight": "#E8F9FA",
      "primaryDark": "#119EA5",
      "secondary": "#FF8156",
      "tertiary": "#FFD166",
      "ink": "#4B4B4B",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#3B82F6"
    },
    "fonts": {
      "primary": "Inter, ui-sans-serif, system-ui, sans-serif"
    },
    "logos": {
      "main": "/assets/images/coratuka-logo.png",
      "icon": "/assets/images/coratuka-icon.png"
    }
  },

  "modules": {
    "emergency": {
      "id": "emergency",
      "name": "Emergency Manager",
      "description": "Handle emergency rescue reports",
      "icon": "🚨",
      "route": "modules/emergency-manager.html",
      "enabled": true,
      "order": 1,
      "permissions": [
        "view_reports",
        "update_status",
        "assign_handler",
        "export_data"
      ],
      "features": {
        "filterReports": true,
        "statusTracking": true,
        "photoGallery": true,
        "exportCSV": true,
        "multiTabSync": true
      },
      "priorities": {
        "urgent": {
          "label": "Urgent",
          "color": "#EF4444",
          "icon": "🔴",
          "conditions": ["dead", "mati", "multiple", "banyak"]
        },
        "high": {
          "label": "High",
          "color": "#F97316",
          "icon": "🟠",
          "conditions": ["injured", "terluka", "entangled", "terjerat"]
        },
        "medium": {
          "label": "Medium",
          "color": "#F59E0B",
          "icon": "🟡",
          "conditions": ["stranded", "terdampar", "sick", "sakit"]
        },
        "low": {
          "label": "Low",
          "color": "#10B981",
          "icon": "🟢",
          "conditions": []
        }
      },
      "statuses": ["pending", "in-progress", "resolved"],
      "pagination": {
        "itemsPerPage": 20,
        "maxVisiblePages": 5
      }
    },

    "challenge": {
      "id": "challenge",
      "name": "Challenge Manager",
      "description": "Manage challenges, rewards & validations",
      "icon": "🏆",
      "route": "modules/challenge-manager.html",
      "enabled": true,
      "order": 2,
      "permissions": [
        "manage_challenges",
        "validate_submissions",
        "manage_rewards",
        "process_redemptions"
      ],
      "features": {
        "challengeCRUD": true,
        "submissionValidation": true,
        "rewardManagement": true,
        "redemptionTracking": true,
        "pointsSystem": true,
        "exportCSV": true
      },
      "tabs": [
        "challenges",
        "validation",
        "rewards",
        "redemptions",
        "statistics"
      ],
      "validationStatuses": ["pending", "approved", "rejected"],
      "rewardTypes": ["merchandise", "voucher", "certificate", "experience"],
      "stockLevels": {
        "low": 30,
        "medium": 70,
        "high": 100
      }
    },

    "campaign": {
      "id": "campaign",
      "name": "Campaign Manager",
      "description": "Manage events & registrations",
      "icon": "📅",
      "route": "modules/campaign-manager.html",
      "enabled": true,
      "order": 3,
      "permissions": [
        "manage_events",
        "view_registrants",
        "track_attendance",
        "export_data"
      ],
      "features": {
        "eventCRUD": true,
        "registrationManagement": true,
        "attendanceTracking": true,
        "featuredEvents": true,
        "exportCSV": true
      },
      "tabs": ["events", "registrants", "attendance", "statistics"],
      "eventStatuses": ["open", "closed", "completed", "cancelled"]
    },

    "classroom": {
      "id": "classroom",
      "name": "Classroom Manager",
      "description": "Manage Ocean Odyssey educational content",
      "icon": "🎓",
      "route": "modules/classroom-manager.html",
      "enabled": true,
      "order": 4,
      "permissions": [
        "manage_lessons",
        "manage_quizzes",
        "view_progress",
        "export_data"
      ],
      "features": {
        "lessonManagement": true,
        "quizBuilder": true,
        "progressTracking": true,
        "multiMascot": true,
        "multiLevel": true,
        "exportCSV": true
      },
      "tabs": ["content", "quiz", "progress", "analytics"],
      "quizTypes": ["multiple-choice", "true-false", "fill-blank"],
      "passingScore": 70
    },

    "beachGuide": {
      "id": "beachGuide",
      "name": "Beach Guide Manager",
      "description": "Manage QR guide content for beaches",
      "icon": "📍",
      "route": "modules/beach-guide-manager.html",
      "enabled": true,
      "order": 5,
      "permissions": [
        "manage_locations",
        "edit_content",
        "generate_qr",
        "view_analytics"
      ],
      "features": {
        "locationManagement": true,
        "richContentEditor": true,
        "qrCodeGeneration": true,
        "scanAnalytics": true,
        "multimediaSupport": true
      },
      "tabs": ["locations", "content", "qrcodes", "analytics"],
      "contentTypes": ["text", "image", "video", "youtube"],
      "qrCodeSettings": {
        "size": 200,
        "colorDark": "#15C5CE",
        "colorLight": "#FFFFFF",
        "correctLevel": "H"
      }
    }
  },

